# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# Public HTTPS clone URL of the repo holding docker-compose.yml and services/
repo_url = "https://github.com/YOURNAME/tf-docker-platform.git"

db_password = "change-me"

# YOUR public IP with /32. Find it: curl -s https://checkip.amazonaws.com
ssh_cidr = "203.0.113.4/32"

